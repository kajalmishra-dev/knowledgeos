# =============================================================================
# KnowledgeOS - Local Development Environment (Docker Compose)
# Copy this file to `.env` in the repository root before running:
#   docker compose up --build
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 17 (pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledgeos
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis 8
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=knowledgeos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Backend (FastAPI) + ingestion worker
# -----------------------------------------------------------------------------
BACKEND_PORT=8000

APP_NAME=KnowledgeOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
JWT_SECRET_KEY=dev-only-change-me

# Docker-internal service hostnames (used by the backend container)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/knowledgeos
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
STORAGE_BACKEND=minio
INGESTION_QUEUE=arq

# -----------------------------------------------------------------------------
# Knowledge / RAG
# Defaults work without an API key (local embeddings + extractive answers).
# For neural embeddings and generated answers:
#   EMBEDDING_PROVIDER=openai
#   CHAT_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL can point at any OpenAI-compatible server (OpenAI, Groq, Ollama).
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10000000
INGESTION_CHUNK_SIZE=800
INGESTION_CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_PROVIDER=extractive
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18
