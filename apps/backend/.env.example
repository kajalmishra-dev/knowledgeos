# =============================================================================
# KnowledgeOS Backend - Environment Variables
# =============================================================================

# Application
APP_NAME=KnowledgeOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Local development (backend run directly on host)
# Start infrastructure first: docker compose up postgres redis minio minio-init -d
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledgeos
DATABASE_ECHO=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledgeos
MINIO_SECURE=false
STORAGE_BACKEND=minio
INGESTION_QUEUE=arq

# Authentication (JWT + refresh cookie)
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_HTTPONLY=true
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# Knowledge / RAG
MAX_UPLOAD_BYTES=10000000
INGESTION_CHUNK_SIZE=800
INGESTION_CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_PROVIDER=extractive
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18

# -----------------------------------------------------------------------------
# Docker Compose (backend run inside container)
# Use root `.env` — these values are injected automatically by docker-compose.yml
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/knowledgeos
# REDIS_URL=redis://redis:6379/0
# MINIO_ENDPOINT=minio:9000
